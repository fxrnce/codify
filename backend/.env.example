# Local defaults. Render supplies PORT automatically in production.
NODE_ENV=development
PORT=3000

# Use * for native-only development. For a web client, use its exact origin.
CORS_ORIGIN=*

# The publishable key is safe to expose; the secret key must remain private.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Use the hosted PostgreSQL connection string in production.
DATABASE_URL=postgresql://username:password@host/database?sslmode=verify-full

# Optional: an S3-compatible bucket for product report photo evidence
# (Cloudflare R2, Supabase Storage, AWS S3, Backblaze B2, MinIO, ...). When
# any of these are missing, evidence upload/view routes respond with a clear
# 503 "not configured" error instead of the server failing to start. Report
# text submission and every other feature work fine without this.
# STORAGE_S3_BUCKET=codify-report-evidence
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=your_access_key_id
# STORAGE_S3_SECRET_ACCESS_KEY=your_secret_access_key
# STORAGE_S3_FORCE_PATH_STYLE=false
