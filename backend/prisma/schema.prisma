generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  APPROVED
  CAUTION
  FDA_ADVISORY
  UNVERIFIED

  @@map("product_status")
}

enum AdvisoryCategory {
  FOOD
  DRUG
  COSMETIC

  @@map("advisory_category")
}

enum AdvisoryType {
  PUBLIC_HEALTH_WARNING
  RECALL
  QUALITY_HOLD
  SAFETY_ALERT
  LIFTING

  @@map("advisory_type")
}

enum AdvisoryStatus {
  NOT_APPROVED
  CAUTION
  LIFTED

  @@map("advisory_status")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED

  @@map("report_status")
}

// Health Star Rating (AU/NZ) categories used by the HSR-based nutrition
// rating estimator. See backend/src/lib/nutrition-score.ts and
// docs/nutrition-rating-methodology.md for the calculation method and
// official references. PLAIN_WATER and UNSWEETENED_FLAVOURED_WATER are
// automatic-rating special cases, not general nutrient-profiling categories.
enum HsrCategory {
  NON_DAIRY_BEVERAGE
  DAIRY_BEVERAGE
  FOOD
  DAIRY_FOOD
  FATS_OILS_SPREADS
  CHEESE
  PLAIN_WATER
  UNSWEETENED_FLAVOURED_WATER

  @@map("hsr_category")
}

enum HsrConfidence {
  COMPLETE
  CONSERVATIVE
  INSUFFICIENT_DATA

  @@map("hsr_confidence")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  allergenIds String[] @default([]) @map("allergen_ids")
  role        UserRole @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  scans   Scan[]
  reports ProductReport[]
  adminActions AdminAuditLog[]

  @@map("users")
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  barcode            String        @unique
  name               String
  brand              String
  category           String
  status             ProductStatus
  fdaStatusLabel     String        @map("fda_status_label")
  registrationNumber String        @map("registration_number")
  servingSize        String        @map("serving_size")
  warningMessage     String        @map("warning_message")
  imageUrl           String?       @map("image_url")
  isArchived         Boolean       @default(false) @map("is_archived")
  verificationUrl    String?       @map("verification_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  nutrition       NutritionFact?
  nutritionRating NutritionRating?
  ingredients     ProductIngredient[]
  allergens       ProductAllergen[]
  alternatives    ProductAlternative[]
  scans           Scan[]
  reports         ProductReport[]

  @@index([status])
  @@index([category])
  @@map("products")
}

model NutritionFact {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @unique @map("product_id") @db.Uuid
  calories       String
  protein        String
  carbohydrates  String
  totalFat       String @map("total_fat")
  saturatedFat   String @default("N/A") @map("saturated_fat")
  totalSugars    String @default("N/A") @map("total_sugars")
  dietaryFiber   String @default("N/A") @map("dietary_fiber")
  sodium         String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("nutrition_facts")
}

// Stores everything needed to reproduce an HSR-based nutrition rating: the
// verified numeric inputs an administrator entered (per serving, as printed
// on the label), the values standardized to per 100 g / 100 mL, the point
// breakdown, and the resulting star rating. The backend always derives
// starRatingHalfSteps and the point fields from the verified inputs via
// backend/src/lib/nutrition-score.ts — nothing here is submitted directly by
// an administrator. A half-star rating is stored as an integer half-step
// from 1 (0.5 star) to 10 (5 stars) to avoid floating-point ambiguity and to
// avoid resembling the old, misleading 0-100 "percentage-like" health score.
model NutritionRating {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @unique @map("product_id") @db.Uuid
  category  HsrCategory
  confidence HsrConfidence
  methodVersion String    @map("method_version")
  reason    String?

  // Verified inputs, as printed on the label, per serving.
  servingQuantity             Float?  @map("serving_quantity")
  servingUnit                 String? @map("serving_unit")
  caloriesPerServing          Float?  @map("calories_per_serving")
  saturatedFatGramsPerServing Float?  @map("saturated_fat_grams_per_serving")
  totalSugarsGramsPerServing  Float?  @map("total_sugars_grams_per_serving")
  sodiumMilligramsPerServing  Float?  @map("sodium_milligrams_per_serving")
  proteinGramsPerServing      Float?  @map("protein_grams_per_serving")
  fibreGramsPerServing        Float?  @map("fibre_grams_per_serving")
  fvnlPercent                 Float?  @map("fvnl_percent")
  containsFruitOrVegetable    Boolean @default(false) @map("contains_fruit_or_vegetable")
  containsNutsOrLegumes       Boolean @default(false) @map("contains_nuts_or_legumes")

  // Values standardized to per 100 g / 100 mL, shown in "Why this rating?".
  energyKilojoulesPer100  Float?
  saturatedFatGramsPer100 Float?
  totalSugarsGramsPer100  Float?
  sodiumMilligramsPer100  Float?
  proteinGramsPer100      Float?
  fibreGramsPer100        Float?

  baselinePoints              Int?     @map("baseline_points")
  proteinPoints               Int?     @map("protein_points")
  fibrePoints                 Int?     @map("fibre_points")
  fvnlPoints                  Int?     @map("fvnl_points")
  finalPoints                 Int?     @map("final_points")
  proteinPointsWithheldByRule Boolean  @default(false) @map("protein_points_withheld_by_rule")
  unavailableComponents       String[] @default([]) @map("unavailable_components")

  // 1 = 0.5 star ... 10 = 5 stars. Null when confidence is INSUFFICIENT_DATA.
  starRatingHalfSteps Int? @map("star_rating_half_steps")

  calculatedAt DateTime @default(now()) @map("calculated_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("nutrition_ratings")
}

model ProductIngredient {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  name       String
  isAllergen Boolean @default(false) @map("is_allergen")
  position   Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_ingredients")
}

model ProductAllergen {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@unique([productId, position])
  @@index([productId])
  @@map("product_allergens")
}

model ProductAlternative {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@unique([productId, position])
  @@index([productId])
  @@map("product_alternatives")
}

model Scan {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  clientScanId String   @map("client_scan_id")
  barcode      String
  scannedAt    DateTime @default(now()) @map("scanned_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, clientScanId])
  @@index([userId, scannedAt])
  @@index([productId])
  @@index([barcode])
  @@map("scans")
}

model ProductReport {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  barcode     String?
  productName String   @map("product_name")
  brand       String
  category    String
  reason      String
  notes       String   @default("")
  submittedAt DateTime @default(now()) @map("submitted_at")
  status ReportStatus @default(PENDING)
  resolutionNote String @default("") @map("resolution_note")
  reviewedAt DateTime? @map("reviewed_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  hiddenByReporter Boolean @default(false) @map("hidden_by_reporter")
  clientReportId String? @map("client_report_id")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  evidence ReportEvidence[]

  @@index([userId, submittedAt])
  @@unique([userId, clientReportId])
  @@index([productId])
  @@index([barcode])
  @@map("product_reports")
}

model ReportEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type")
  byteSize   Int      @map("byte_size")
  width      Int?
  height     Int?
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")

  report ProductReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@index([reportId])
  @@map("report_evidence")
}

// A durable record of a storage object that failed to delete immediately
// (e.g. the provider was unreachable when a report was deleted), so cleanup
// can be retried later instead of silently leaking the object.
model StorageCleanupTask {
  id         String   @id @default(uuid()) @db.Uuid
  storageKey String   @map("storage_key")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("storage_cleanup_tasks")
}

model AdminAuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  entityType String @map("entity_type")
  entityId String @map("entity_id") @db.Uuid
  action String
  before Json?
  after Json
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@map("admin_audit_logs")
}

model FdaAdvisory {
  id                 String           @id @default(uuid()) @db.Uuid
  advisoryNumber     String           @unique @map("advisory_number")
  title              String
  category           AdvisoryCategory
  type               AdvisoryType
  status             AdvisoryStatus
  publishedAt        DateTime         @map("published_at") @db.Date
  sourceUrl           String           @map("source_url")
  filipinoSourceUrl   String?          @map("filipino_source_url")
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@index([category, publishedAt])
  @@index([status, publishedAt])
  @@map("fda_advisories")
}
