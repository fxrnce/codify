generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  APPROVED
  CAUTION
  FDA_ADVISORY
  UNVERIFIED

  @@map("product_status")
}

enum AdvisoryCategory {
  FOOD
  DRUG
  COSMETIC

  @@map("advisory_category")
}

enum AdvisoryType {
  PUBLIC_HEALTH_WARNING
  RECALL
  QUALITY_HOLD
  SAFETY_ALERT
  LIFTING

  @@map("advisory_type")
}

enum AdvisoryStatus {
  NOT_APPROVED
  CAUTION
  LIFTED

  @@map("advisory_status")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED

  @@map("report_status")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  allergenIds String[] @default([]) @map("allergen_ids")
  role        UserRole @default(USER)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  scans   Scan[]
  reports ProductReport[]
  adminActions AdminAuditLog[]

  @@map("users")
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  barcode            String        @unique
  name               String
  brand              String
  category           String
  status             ProductStatus
  fdaStatusLabel     String        @map("fda_status_label")
  registrationNumber String        @map("registration_number")
  healthScore        Int?          @map("health_score")
  servingSize        String        @map("serving_size")
  warningMessage     String        @map("warning_message")
  imageUrl           String?       @map("image_url")
  isArchived         Boolean       @default(false) @map("is_archived")
  verificationUrl    String?       @map("verification_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  nutrition    NutritionFact?
  ingredients  ProductIngredient[]
  allergens    ProductAllergen[]
  alternatives ProductAlternative[]
  scans        Scan[]
  reports      ProductReport[]

  @@index([status])
  @@index([category])
  @@map("products")
}

model NutritionFact {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @unique @map("product_id") @db.Uuid
  calories       String
  protein        String
  carbohydrates  String
  totalFat       String @map("total_fat")
  saturatedFat   String @default("N/A") @map("saturated_fat")
  totalSugars    String @default("N/A") @map("total_sugars")
  dietaryFiber   String @default("N/A") @map("dietary_fiber")
  sodium         String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("nutrition_facts")
}

model ProductIngredient {
  id         String  @id @default(uuid()) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  name       String
  isAllergen Boolean @default(false) @map("is_allergen")
  position   Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_ingredients")
}

model ProductAllergen {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@unique([productId, position])
  @@index([productId])
  @@map("product_allergens")
}

model ProductAlternative {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@unique([productId, position])
  @@index([productId])
  @@map("product_alternatives")
}

model Scan {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  clientScanId String   @map("client_scan_id")
  barcode      String
  scannedAt    DateTime @default(now()) @map("scanned_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, clientScanId])
  @@index([userId, scannedAt])
  @@index([productId])
  @@index([barcode])
  @@map("scans")
}

model ProductReport {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  barcode     String?
  productName String   @map("product_name")
  brand       String
  category    String
  reason      String
  notes       String   @default("")
  submittedAt DateTime @default(now()) @map("submitted_at")
  status ReportStatus @default(PENDING)
  resolutionNote String @default("") @map("resolution_note")
  reviewedAt DateTime? @map("reviewed_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  hiddenByReporter Boolean @default(false) @map("hidden_by_reporter")
  clientReportId String? @map("client_report_id")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  evidence ReportEvidence[]

  @@index([userId, submittedAt])
  @@unique([userId, clientReportId])
  @@index([productId])
  @@index([barcode])
  @@map("product_reports")
}

model ReportEvidence {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type")
  byteSize   Int      @map("byte_size")
  width      Int?
  height     Int?
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")

  report ProductReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, position])
  @@index([reportId])
  @@map("report_evidence")
}

// A durable record of a storage object that failed to delete immediately
// (e.g. the provider was unreachable when a report was deleted), so cleanup
// can be retried later instead of silently leaking the object.
model StorageCleanupTask {
  id         String   @id @default(uuid()) @db.Uuid
  storageKey String   @map("storage_key")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("storage_cleanup_tasks")
}

model AdminAuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  entityType String @map("entity_type")
  entityId String @map("entity_id") @db.Uuid
  action String
  before Json?
  after Json
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@map("admin_audit_logs")
}

model FdaAdvisory {
  id                 String           @id @default(uuid()) @db.Uuid
  advisoryNumber     String           @unique @map("advisory_number")
  title              String
  category           AdvisoryCategory
  type               AdvisoryType
  status             AdvisoryStatus
  publishedAt        DateTime         @map("published_at") @db.Date
  sourceUrl           String           @map("source_url")
  filipinoSourceUrl   String?          @map("filipino_source_url")
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([publishedAt])
  @@index([category, publishedAt])
  @@index([status, publishedAt])
  @@map("fda_advisories")
}
